<UserControl x:Class="PowerHub.Controls.AutomationSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PowerHub.Controls"
             Foreground="{DynamicResource TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="AutomationCaption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/></Style>
        <Style x:Key="AutomationCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
        <Style x:Key="AutomationCommand" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="11,7"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,7,7"/></Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:T '外设自动化中心'}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{loc:T '让设备、应用和时间触发你的桌面流程。'}" Style="{StaticResource AutomationCaption}" Margin="0,8,0,0"/></StackPanel>
            <CheckBox x:Name="EnabledBox" Grid.Column="1" Content="{loc:T '启用自动化'}" Click="OnEnabled" VerticalAlignment="Center"/>
        </Grid>
        <Border Background="{DynamicResource AccentSoft}" CornerRadius="13" Padding="19,16" Margin="0,0,0,20"><StackPanel>
            <TextBlock x:Name="StateText" Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:T '首次采样建立基线；暂停期间不执行动作，恢复后不会重放错过的事件。'}" Style="{StaticResource AutomationCaption}" Margin="0,7,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource AutomationCard}"><StackPanel>
            <WrapPanel Margin="0,0,0,4">
                <Button Content="{loc:T '新建规则'}" Click="OnNew" Style="{StaticResource AutomationCommand}"/>
                <ComboBox x:Name="TemplateCombo" Width="175" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnTemplate" Margin="0,0,7,7" AutomationProperties.Name="{loc:T '从模板创建'}"/>
                <Button x:Name="RestoreAllButton" Content="{loc:T '恢复全部配置'}" Click="OnRestoreAll" Style="{StaticResource AutomationCommand}"/>
                <Button Content="{loc:T '刷新音频输出'}" Click="OnRefreshAudio" Style="{StaticResource AutomationCommand}"/>
            </WrapPanel>
            <TextBlock x:Name="AudioStatusText" Style="{StaticResource AutomationCaption}"/>
            <TextBlock x:Name="ProcessStatusText" Foreground="{DynamicResource Warning}" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource AutomationCaption}" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <Border x:Name="EmptyState" Style="{StaticResource AutomationCard}"><StackPanel>
            <TextBlock Text="{loc:T '创建你的第一条联动规则'}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:T '例如：耳机连接后切换输出，游戏退出后恢复原配置。'}" Style="{StaticResource AutomationCaption}" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <ItemsControl x:Name="RuleItems"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource AutomationCard}"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Style="{StaticResource AutomationCaption}" Margin="0,7,0,0"/></StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding Id}" Click="OnRuleEnabled" Content="{loc:T '启用'}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top"/>
                </Grid>
                <TextBlock Text="{Binding Details}" Style="{StaticResource AutomationCaption}" Margin="0,8,0,14"/>
                <WrapPanel>
                    <Button Content="{loc:T '编辑'}" Tag="{Binding Id}" Click="OnEdit" Style="{StaticResource AutomationCommand}"/>
                    <Button Content="{loc:T '复制'}" Tag="{Binding Id}" Click="OnDuplicate" Style="{StaticResource AutomationCommand}"/>
                    <Button Content="{loc:T '检查规则'}" Tag="{Binding Id}" Click="OnPreview" Style="{StaticResource AutomationCommand}"/>
                    <Button Content="{loc:T '立即执行'}" Tag="{Binding Id}" Click="OnRun" IsEnabled="{Binding CanExecute}" Style="{StaticResource AutomationCommand}"/>
                    <Button Content="{loc:T '恢复此规则'}" Tag="{Binding Id}" Click="OnRestore" IsEnabled="{Binding CanRestore}" Style="{StaticResource AutomationCommand}"/>
                    <Button Content="{loc:T '删除'}" Tag="{Binding Id}" Click="OnDelete" Style="{StaticResource AutomationCommand}"/>
                </WrapPanel>
            </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Border Style="{StaticResource AutomationCard}"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{loc:T '执行记录'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{loc:T '清空记录'}" Click="OnClearHistory" Padding="11,7" FontSize="11"/></Grid>
            <TextBlock x:Name="HistoryEmptyText" Text="{loc:T '尚无执行记录；规则执行后可展开查看每一步。'}" Style="{StaticResource AutomationCaption}" Margin="0,14,0,0"/>
            <TextBlock x:Name="HistoryErrorText" Foreground="{DynamicResource Warning}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <ItemsControl x:Name="HistoryItems" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                <Expander Header="{Binding Header}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Details}" Style="{StaticResource AutomationCaption}" Margin="20,8,0,12"/></Expander>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border>
    </StackPanel>
</UserControl>
