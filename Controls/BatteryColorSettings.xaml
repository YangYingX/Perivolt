<UserControl x:Class="PowerHub.Controls.BatteryColorSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PowerHub.Controls"
             Foreground="{DynamicResource TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="ColorField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="104"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MaxLength" Value="7"/>
        </Style>
        <Style x:Key="ColorCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style x:Key="ColorSwatchButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="ToolTip" Value="打开颜色选择器"/>
        </Style>
    </UserControl.Resources>
    <Border Padding="23" Margin="0,0,0,16" CornerRadius="16" BorderThickness="1"
            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}">
        <StackPanel>
            <Grid>
                <TextBlock Text="电量，也有自己的颜色" FontSize="15" FontWeight="SemiBold"/>
                <CheckBox x:Name="GradientBox" Content="启用渐变" Click="OnGradientClick" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
            <TextBlock Text="按电量区间配色；关闭渐变时使用起始颜色。配色边界独立于充电提醒阈值。"
                       Style="{StaticResource ColorCaption}" TextWrapping="Wrap" Margin="0,8,0,18"/>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="低电上限" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="LowThresholdBox" Width="58" Padding="9,7" MaxLength="3" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown" AutomationProperties.Name="低电量颜色上限"/>
                    <TextBlock Text="%" Style="{StaticResource ColorCaption}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="中电上限" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="MediumThresholdBox" Width="58" Padding="9,7" MaxLength="3" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown" AutomationProperties.Name="中电量颜色上限"/>
                    <TextBlock Text="%" Style="{StaticResource ColorCaption}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                <TextBlock Text="电量区间" Style="{StaticResource ColorCaption}" Margin="0,0,0,5"/>
                <TextBlock Grid.Column="1" Text="起始颜色" Style="{StaticResource ColorCaption}"/>
                <TextBlock Grid.Column="2" Text="结束颜色" Style="{StaticResource ColorCaption}"/>
                <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="低电量" FontSize="12"/><TextBlock x:Name="LowRangeText" Style="{StaticResource ColorCaption}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock Text="中等电量" FontSize="12"/><TextBlock x:Name="MediumRangeText" Style="{StaticResource ColorCaption}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Row="3" VerticalAlignment="Center"><TextBlock Text="充足电量" FontSize="12"/><TextBlock x:Name="HighRangeText" Style="{StaticResource ColorCaption}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ColorSwatchButton}" Tag="LowColorStart" Click="OnPickColor" AutomationProperties.Name="选择低电量起始颜色"><Border x:Name="LowStartSwatch" Width="24" Height="24" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Stroke}"/></Button>
                    <TextBox x:Name="LowStartBox" Style="{StaticResource ColorField}" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown" AutomationProperties.Name="低电量起始颜色"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ColorSwatchButton}" Tag="LowColorEnd" Click="OnPickColor" AutomationProperties.Name="选择低电量结束颜色"><Border x:Name="LowEndSwatch" Width="24" Height="24" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Stroke}"/></Button>
                    <TextBox x:Name="LowEndBox" Style="{StaticResource ColorField}" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown" AutomationProperties.Name="低电量结束颜色"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ColorSwatchButton}" Tag="MediumColorStart" Click="OnPickColor" AutomationProperties.Name="选择中等电量起始颜色"><Border x:Name="MediumStartSwatch" Width="24" Height="24" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Stroke}"/></Button>
                    <TextBox x:Name="MediumStartBox" Style="{StaticResource ColorField}" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown" AutomationProperties.Name="中等电量起始颜色"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ColorSwatchButton}" Tag="MediumColorEnd" Click="OnPickColor" AutomationProperties.Name="选择中等电量结束颜色"><Border x:Name="MediumEndSwatch" Width="24" Height="24" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Stroke}"/></Button>
                    <TextBox x:Name="MediumEndBox" Style="{StaticResource ColorField}" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown" AutomationProperties.Name="中等电量结束颜色"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ColorSwatchButton}" Tag="HighColorStart" Click="OnPickColor" AutomationProperties.Name="选择充足电量起始颜色"><Border x:Name="HighStartSwatch" Width="24" Height="24" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Stroke}"/></Button>
                    <TextBox x:Name="HighStartBox" Style="{StaticResource ColorField}" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown" AutomationProperties.Name="充足电量起始颜色"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ColorSwatchButton}" Tag="HighColorEnd" Click="OnPickColor" AutomationProperties.Name="选择充足电量结束颜色"><Border x:Name="HighEndSwatch" Width="24" Height="24" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Stroke}"/></Button>
                    <TextBox x:Name="HighEndBox" Style="{StaticResource ColorField}" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown" AutomationProperties.Name="充足电量结束颜色"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="11" Padding="12" Margin="0,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><Grid Width="52" Height="52"><controls:BatteryVisual x:Name="LowPreview" Percent="20" AnimationsEnabled="False" DisplayStyle="Ring" TrackBrush="{DynamicResource RingTrack}"/><TextBlock Text="20%" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid><TextBlock Text="静态预览" Style="{StaticResource ColorCaption}" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><Grid Width="52" Height="52"><controls:BatteryVisual x:Name="MediumPreview" Percent="50" AnimationsEnabled="False" DisplayStyle="Ring" TrackBrush="{DynamicResource RingTrack}"/><TextBlock Text="50%" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid><TextBlock Text="静态预览" Style="{StaticResource ColorCaption}" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><Grid Width="52" Height="52"><controls:BatteryVisual x:Name="HighPreview" Percent="80" AnimationsEnabled="False" DisplayStyle="Ring" TrackBrush="{DynamicResource RingTrack}"/><TextBlock Text="80%" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid><TextBlock Text="静态预览" Style="{StaticResource ColorCaption}" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
