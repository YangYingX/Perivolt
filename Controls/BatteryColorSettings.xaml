<UserControl x:Class="PowerHub.Controls.BatteryColorSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:PowerHub.Controls"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PowerHub.Controls"
             Foreground="{DynamicResource TextPrimary}" LostMouseCapture="OnNodeCaptureLost">
    <UserControl.Resources>
        <Style x:Key="ColorCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="17"/></Style>
        <Style x:Key="PositionField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Width" Value="60"/><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="5,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="MaxLength" Value="5"/></Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{loc:T '整体不透明度'}" FontSize="13" FontWeight="SemiBold"/>
        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
            <Slider x:Name="ColorOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnColorOpacityChanged" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{loc:T '电量颜色整体不透明度'}"/>
            <TextBox x:Name="ColorOpacityBox" Grid.Column="1" Style="{StaticResource PositionField}" TextChanged="OnColorOpacityInput" LostFocus="OnPositionLostFocus" KeyDown="OnPositionKeyDown" AutomationProperties.Name="{loc:T '电量颜色不透明度百分比'}"/>
            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
        </Grid>
        <TextBlock Text="{loc:T '100% 完全显示，0% 完全透明；单独控制电量颜色。'}" Style="{StaticResource ColorCaption}" Margin="0,6,0,0"/>
        <TextBlock x:Name="OpacityErrorText" Foreground="{DynamicResource Danger}" FontSize="11" Text="{loc:T '请输入 0–100 的整数。'}" Visibility="Collapsed" Margin="0,5,0,0"/>
        <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,17,0,18"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0"><CheckBox x:Name="LevelGradientBox" Content="{loc:T '随电量平滑变色'}" Click="OnModeChanged"/><TextBlock Text="{loc:T '根据当前电量，混合相邻节点颜色。'}" Style="{StaticResource ColorCaption}" Margin="0,7,0,0"/></StackPanel>
            <StackPanel Grid.Column="1"><CheckBox x:Name="ShapeGradientBox" Content="{loc:T '图形渐变填充'}" Click="OnModeChanged"/><TextBlock Text="{loc:T '在电量图形内同时铺开多种颜色。'}" Style="{StaticResource ColorCaption}" Margin="0,7,0,0"/></StackPanel>
        </Grid>
        <TextBlock x:Name="ModeHint" Style="{StaticResource ColorCaption}" Margin="0,12,0,0"/>
        <TextBlock Text="{loc:T '电量区间配色预览'}" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,9"/>
        <Border x:Name="ColorBand" Height="16" CornerRadius="6" AutomationProperties.Name="{loc:T '电量区间配色，从左侧 0% 到右侧 100%'}"/>
        <Grid Margin="0,5,0,0"><TextBlock Text="0%" Style="{StaticResource ColorCaption}"/><TextBlock Text="100%" Style="{StaticResource ColorCaption}" HorizontalAlignment="Right"/></Grid>
        <TextBlock Text="{loc:T '节点表示电量区间上限；关闭过渡时，区间使用右侧节点颜色。'}" Style="{StaticResource ColorCaption}" Margin="0,3,0,18"/>
        <Grid Margin="0,0,0,10"><TextBlock Text="{loc:T '颜色节点'}" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="NodeCountText" Style="{StaticResource ColorCaption}" HorizontalAlignment="Right"/></Grid>
        <ItemsControl x:Name="NodeItems">
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="22"/><ColumnDefinition Width="104"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{loc:T '颜色节点位置'}"/>
                        <TextBox Grid.Column="2" Style="{StaticResource PositionField}" Text="{Binding PositionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnPositionLostFocus" KeyDown="OnPositionKeyDown" AutomationProperties.Name="{loc:T '颜色节点百分比'}"/>
                        <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <Button Grid.Column="4" Height="34" Padding="7,0" Click="OnPickColor" ToolTip="{loc:T '选择节点颜色'}"><StackPanel Orientation="Horizontal"><Border Width="15" Height="15" CornerRadius="5" Background="{Binding ColorBrush}" Margin="0,0,7,0"/><TextBlock Text="{Binding Color}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Grid.Column="5" Style="{StaticResource QuietButton}" Padding="6" Click="OnRemoveNode" IsEnabled="{Binding CanRemove}" ToolTip="{loc:T '移除颜色节点'}" AutomationProperties.Name="{loc:T '移除颜色节点'}"><Path Data="M1,1 L9,9 M9,1 L1,9" Width="10" Height="10" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"/></Button>
                        <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Content="{Binding TransitionLabel}" IsChecked="{Binding InterpolateToNext, Mode=TwoWay}" Visibility="{Binding TransitionVisibility}" FontSize="11" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Margin="0,3,0,0"><Button x:Name="AddNodeButton" Content="{loc:T '添加颜色节点'}" HorizontalAlignment="Left" Click="OnAddNode" Padding="12,7"/><Button x:Name="ResetColorsButton" Content="{loc:T '重置配色'}" Style="{StaticResource QuietButton}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" Click="OnResetColors" Padding="0,7"/></Grid>
        <TextBlock x:Name="InheritanceHint" Style="{StaticResource ColorCaption}" Margin="0,12,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="11" Padding="14" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="68" Height="68" HorizontalAlignment="Left"><controls:BatteryVisual x:Name="LowPreview" TrackBrush="{DynamicResource RingTrack}"/><TextBlock x:Name="LowPreviewNumber" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="ColorPreviewName" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="ColorPreviewCaption" Style="{StaticResource ColorCaption}" Margin="0,6,0,0"/></StackPanel></Grid></Border>
    </StackPanel>
</UserControl>
