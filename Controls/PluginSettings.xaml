<UserControl x:Class="PowerHub.Controls.PluginSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:PowerHub.Controls"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="PluginCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="PluginToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Track" Width="36" Height="21" CornerRadius="11" Background="{DynamicResource RingTrack}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                    <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="{DynamicResource Surface}" Margin="3,0" HorizontalAlignment="Left"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentText}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0"><TextBlock Text="{loc:T '插件'}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{loc:T '为桌面添一点风格，为电量提醒添一点便利。'}" Style="{StaticResource PluginCaption}" Margin="0,8,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="OnOpenDirectory" Padding="12,9" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{loc:T '插件目录'}"/></StackPanel></Button>
                <Button x:Name="ReloadButton" Content="{loc:T '重新加载'}" Click="OnReload" Padding="12,9"/>
            </StackPanel>
        </Grid>
        <Border Background="{DynamicResource AccentSoft}" CornerRadius="13" Padding="19,16" Margin="0,0,0,22">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:T '按需开启，轻量运行'}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{loc:T '主题、提醒和设备适配，都可以单独启用。'}" Style="{StaticResource PluginCaption}" Margin="0,6,0,0"/></StackPanel>
                <TextBlock x:Name="SummaryText" Text="{loc:T '正在读取插件…'}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ItemsControl x:Name="PluginItems" Margin="-6,0,-6,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="15" Padding="20" Margin="6,0,6,12">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" Background="{DynamicResource AccentSoft}" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{Binding KindLabel}" Style="{StaticResource PluginCaption}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource PluginToggle}" IsChecked="{Binding IsEnabled, Mode=OneWay}" Tag="{Binding Id}" Click="OnEnabledClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" ToolTip="{loc:T '启用或停用此插件'}" AutomationProperties.Name="{Binding Name, StringFormat=启用 {0}}"/>
                        </Grid>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource PluginCaption}" Margin="0,16,0,0"/>
                        <Button Content="{loc:T '选择主题'}" Click="OnBrowseThemes" HorizontalAlignment="Left" Padding="12,7" Margin="0,12,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Kind}" Value="theme"/><Condition Binding="{Binding IsEnabled}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="{loc:T '打开插件'}" Tag="{Binding Id}" Click="OnOpenPlugin" HorizontalAlignment="Left" Padding="12,7" Margin="0,12,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Kind}" Value="interactive"/><Condition Binding="{Binding IsEnabled}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="7" Padding="10,8" Margin="0,13,0,0"><TextBlock Text="{Binding Status}" Style="{StaticResource PluginCaption}" FontSize="10"/></Border>
                        <ItemsControl ItemsSource="{Binding Options}" Margin="0,7,0,0">
                            <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,10,7,0"><TextBlock Text="{Binding Label}" Style="{StaticResource PluginCaption}" FontSize="10"/><TextBox Text="{Binding Value, Mode=OneWay}" LostKeyboardFocus="OnOptionLostFocus" KeyDown="OnOptionKeyDown" Margin="0,6,0,0" Padding="10,7" FontSize="11" ToolTip="{loc:T '按 Enter 或离开输入框保存'}" AutomationProperties.Name="{Binding Label}"/></StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="EmptyState" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="15" Padding="28" Margin="0,0,0,18" Visibility="Collapsed"><StackPanel><TextBlock Text="{loc:T '插件目录暂时是空的'}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{loc:T '放入插件及其清单后，点击重新加载。'}" Style="{StaticResource PluginCaption}" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel></Border>
        <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="1,18,1,0" Margin="0,8,0,0">
            <StackPanel><TextBlock Text="{loc:T '主题插件启用后会出现在设置的通用主题列表中，选中才应用。'}" Style="{StaticResource PluginCaption}"/><TextBlock Text="{loc:T '本地插件放入插件目录并附带清单，重新加载后即可使用。仅启用信任来源的插件。'}" Style="{StaticResource PluginCaption}" Margin="0,5,0,0"/><TextBlock x:Name="StatusText" Text="{loc:T '插件选项会自动保存。'}" Foreground="{DynamicResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0"/></StackPanel>
        </Border>
    </StackPanel>
</UserControl>
