<UserControl x:Class="PowerHub.Controls.UpdateSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:PowerHub.Controls"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,0,18">
        <StackPanel>
            <Grid><TextBlock Text="{loc:T '版本与更新'}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/></Grid>
            <TextBlock Text="{loc:T '默认离线。开启后每 12 小时检查一次新版本。'}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,8,0,18" TextWrapping="Wrap"/>
            <CheckBox x:Name="EnabledBox" Content="{loc:T '自动检查更新'}" Click="OnEnabledClick"/>
            <TextBlock Text="{loc:T '仅访问项目 GitHub，不上传设备或个人设置。新版由你选择下载安装。'}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,10,0,18" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="CheckButton" Content="{loc:T '立即检查'}" Click="OnCheck" Padding="14,8" Margin="0,0,10,0"/>
                <Button x:Name="DownloadButton" Content="{loc:T '查看新版本'}" Click="OnDownload" Padding="14,8" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
