<UserControl x:Class="PowerHub.Controls.UpdateSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:PowerHub.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,0,18">
        <StackPanel>
            <Grid><TextBlock Text="{loc:T '版本与更新'}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/></Grid>
            <TextBlock Text="{loc:T '默认离线。开启后每 12 小时检查一次新版本。'}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,8,0,18" TextWrapping="Wrap"/>
            <CheckBox x:Name="EnabledBox" Content="{loc:T '自动检查更新'}" Click="OnEnabledClick"/>
            <TextBlock Text="{loc:T '点击“下载并安装”后，校验完成会打开安装向导；安装目录可在向导中确认。更新检查不上传设备或个人设置。'}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,10,0,18" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="InstallDirectoryText" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <Grid x:Name="DownloadProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceAlt}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="{loc:T '取消下载'}" Click="OnCancelDownload" Padding="12,6"/>
            </Grid>
            <WrapPanel Margin="0,14,0,0">
                <Button x:Name="CheckButton" Content="{loc:T '立即检查'}" Click="OnCheck" Padding="14,8" Margin="0,0,10,6"/>
                <Button x:Name="DownloadButton" Content="{loc:T '下载并安装'}" Click="OnDownload" Padding="14,8" Margin="0,0,10,6" Visibility="Collapsed"/>
                <Button x:Name="ReleaseButton" Content="{loc:T '查看发行页'}" Click="OnOpenRelease" Padding="12,8" Margin="0,0,0,6" Visibility="Collapsed"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
