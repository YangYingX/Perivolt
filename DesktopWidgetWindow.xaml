<Window x:Class="PowerHub.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:PowerHub.Controls"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PowerHub.Controls"
        Title="{loc:T 'PowerHub 桌面卡片'}" Width="312" SizeToContent="Height" MaxHeight="600"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="DeviceTypeIcon" TargetType="Path">
            <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers><DataTrigger Binding="{Binding Compact}" Value="True"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="WidgetIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WidgetSurface" Margin="8" Padding="16,14,16,12" CornerRadius="20" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect x:Name="WidgetShadow" Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="2"/>
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource Stroke}" Opened="OnContextMenuOpened">
                <MenuItem Header="{loc:T '打开电量中心'}" Click="OnOpenDashboard"/>
                <Separator/>
                <MenuItem x:Name="TopmostMenuItem" Header="{loc:T '始终置顶'}" IsCheckable="True" Click="OnTopmostClick"/>
                <MenuItem x:Name="LockedMenuItem" Header="{loc:T '锁定位置'}" IsCheckable="True" Click="OnLockClick"/>
                <Separator/>
                <MenuItem Header="{loc:T '隐藏桌面卡片'}" Click="OnHideWidget"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
            <Grid x:Name="DragHeader" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown" Background="Transparent"
                  Margin="0,0,0,12" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,7,0"/>
                        <TextBlock Text="{loc:T '桌面电量'}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="SummaryText" Text="{loc:T '随时留意你的设备'}" Margin="13,4,0,0"
                               Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                </StackPanel>
                <Button x:Name="ToggleLockButton" Grid.Column="1" Style="{StaticResource WidgetIconButton}" Click="OnToggleLock"
                        ToolTip="{loc:T '锁定位置'}" AutomationProperties.Name="{loc:T '锁定位置'}">
                    <Path x:Name="LockStateIcon" Width="12" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="OpenDashboardButton" Grid.Column="2" Style="{StaticResource WidgetIconButton}" Click="OnOpenDashboard"
                        ToolTip="{loc:T '打开电量中心'}" AutomationProperties.Name="{loc:T '打开电量中心'}">
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                </Button>
                <Button x:Name="HideWidgetButton" Grid.Column="3" Style="{StaticResource WidgetIconButton}" Click="OnHideWidget"
                        ToolTip="{loc:T '隐藏桌面卡片'}" AutomationProperties.Name="{loc:T '隐藏桌面卡片'}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="440">
                <ItemsControl x:Name="DeviceItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="13">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Padding" Value="12"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Compact}" Value="True">
                                                <Setter Property="Padding" Value="9,3"/>
                                                <Setter Property="Margin" Value="0,0,0,4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Transparent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WidgetRowBackdrop}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions><controls:CardBatteryFill Grid.ColumnSpan="2" Panel.ZIndex="-1" Percent="{Binding Percent}" Fill="{Binding BatteryBrush}" FillOpacity="{Binding FillOpacity}" ColorOpacity="{Binding ColorOpacity}" AnimationsEnabled="{Binding AnimationsEnabled}" IsCharging="{Binding IsCharging}" AnimationIntensity="{Binding AnimationIntensity}" Visibility="{Binding CardFillVisibility}" IsHitTestVisible="False"><controls:CardBatteryFill.Style><Style TargetType="controls:CardBatteryFill"><Setter Property="Margin" Value="-12"/><Style.Triggers><DataTrigger Binding="{Binding Compact}" Value="True"><Setter Property="Margin" Value="-9,-3"/></DataTrigger></Style.Triggers></Style></controls:CardBatteryFill.Style></controls:CardBatteryFill>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{Binding IconGeometry}" Style="{StaticResource DeviceTypeIcon}"/><controls:OutlinedText Grid.Column="1" Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/></Grid>
                                        <controls:OutlinedText Text="{Binding Status}" Margin="0,5,0,0" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis">
                                            <controls:OutlinedText.Style>
                                                <Style TargetType="controls:OutlinedText">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Compact}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:OutlinedText.Style>
                                        </controls:OutlinedText>
                                        <controls:OutlinedText Text="{Binding Advice}" Margin="0,4,0,0" FontSize="10">
                                            <controls:OutlinedText.Style>
                                                <Style TargetType="controls:OutlinedText">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Advice}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NeedsCharge}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:OutlinedText.Style>
                                        </controls:OutlinedText>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center"
                                          ToolTip="{Binding BatteryDescription}" AutomationProperties.Name="{Binding BatteryDescription}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Width" Value="{Binding BatteryVisualSize}"/>
                                                <Setter Property="Height" Value="{Binding BatteryVisualSize}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DisplayStyle}" Value="Bar"><Setter Property="Width" Value="60"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding DisplayStyle}" Value="Hourglass"><Setter Property="Width" Value="Auto"/></DataTrigger>
                                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DisplayStyle}" Value="Bar"/><Condition Binding="{Binding Compact}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Width" Value="52"/></MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <controls:BatteryVisual Visibility="{Binding BatteryGraphicVisibility}" Percent="{Binding Percent}" DisplayStyle="{Binding DisplayStyle}" AnimationsEnabled="{Binding AnimationsEnabled}" FillOpacity="{Binding FillOpacity}" ColorOpacity="{Binding ColorOpacity}" AnimationIntensity="{Binding AnimationIntensity}" IsCharging="{Binding IsCharging}" Foreground="{Binding BatteryBrush}" TrackBrush="{DynamicResource RingTrack}">
                                            <controls:BatteryVisual.Style>
                                                <Style TargetType="controls:BatteryVisual">
                                                    <Setter Property="Width" Value="{Binding BatteryVisualSize}"/><Setter Property="Height" Value="{Binding BatteryVisualSize}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DisplayStyle}" Value="Bar"><Setter Property="Width" Value="60"/></DataTrigger>
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DisplayStyle}" Value="Bar"/><Condition Binding="{Binding Compact}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Width" Value="52"/></MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:BatteryVisual.Style>
                                        </controls:BatteryVisual>
                                        <controls:BatteryVisual DisplayStyle="Charge" ColorOpacity="{Binding ColorOpacity}" IsCharging="{Binding IsCharging}" AnimationsEnabled="{Binding AnimationsEnabled}" AnimationIntensity="{Binding AnimationIntensity}" Foreground="{DynamicResource Accent}" Visibility="{Binding CardFillVisibility}"/>
                                        <Grid Visibility="{Binding BatteryPercentageVisibility}">
                                            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding DisplayStyle}" Value="Hourglass"><Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="MinWidth" Value="36"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                        <controls:OutlinedText Text="{Binding BatteryLabel}" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <controls:OutlinedText.Style>
                                                <Style TargetType="controls:OutlinedText">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Compact}" Value="True">
                                                            <Setter Property="FontSize" Value="10"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DisplayStyle}" Value="Bar"><Setter Property="FontSize" Value="13"/></DataTrigger>
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DisplayStyle}" Value="Bar"/><Condition Binding="{Binding Compact}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="FontSize" Value="12"/></MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding DisplayStyle}" Value="Hourglass"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontSize" Value="12"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:OutlinedText.Style>
                                        </controls:OutlinedText>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="EmptyState" Padding="16,20" Margin="0,0,0,8" Background="{DynamicResource SurfaceAlt}" CornerRadius="13">
                <StackPanel>
                    <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:T '当前没有已连接的固定设备'}" Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyExplanation" Text="{loc:T '连接外设后，在电量中心点击固定，&#10;就能在这里查看电量。'}" Margin="0,7,0,0"
                               FontSize="11" LineHeight="18" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center"/>
                    <Button Content="{loc:T '选择设备  →'}" Click="OnOpenDashboard" Margin="0,12,0,0" Padding="8,6"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}" Cursor="Hand"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="FooterText" Text="{loc:T 'PowerHub &#183; 充电提醒已开启'}" FontSize="9" Margin="1,2,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
    </Border>
</Window>
