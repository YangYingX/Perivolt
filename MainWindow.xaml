<Window x:Class="PowerHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PowerHub.Controls"
        Title="PowerHub · 外设电量中心" Icon="/PowerHub;component/Assets/powerhub.ico" Width="1080" Height="780" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource PageBackground}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="LineHeight" Value="18"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DeviceTypeIcon" TargetType="Path">
            <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="46"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="Track" Width="36" Height="21" CornerRadius="11" Background="{DynamicResource RingTrack}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                        <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="{DynamicResource Surface}" Margin="3,0" HorizontalAlignment="Left"/>
                    </Border>
                    <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentText}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CompactNumber" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Width" Value="60"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="7,0"/><Setter Property="FontSize" Value="13"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MaxLength" Value="3"/></Style>
        <Style x:Key="BatteryPercentage" TargetType="TextBlock"><Setter Property="Visibility" Value="{Binding BatteryPercentageVisibility}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="FontSize" Value="16"/></Style>
        <Style x:Key="OverviewBatteryShape" TargetType="controls:BatteryVisual"><Setter Property="Width" Value="70"/><Setter Property="Height" Value="70"/></Style>
    </Window.Resources>
    <Border x:Name="PanelSurface" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14" RenderTransformOrigin="0.5,0.65">
        <Border.RenderTransform><ScaleTransform x:Name="PanelScale"/></Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Background="{DynamicResource Surface}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="23,0,0,0">
                    <Border Width="23" Height="23" CornerRadius="7" Background="Transparent">
                        <Image Source="/PowerHub;component/Assets/powerhub-32.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="PowerHub" FontWeight="Bold" FontSize="15" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="外设电量中心" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="44" Style="{StaticResource QuietButton}" Click="OnMinimize" ToolTip="最小化到托盘" AutomationProperties.Name="最小化到托盘"><Path Data="M0,5 H12" Width="12" Height="10" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2"/></Button>
                    <Button Width="44" Style="{StaticResource QuietButton}" Click="OnMaximize" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原"><Path x:Name="MaximizeIcon" Data="M1,1 H11 V11 H1 Z" Width="12" Height="12" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2"/></Button>
                    <Button Width="46" Style="{StaticResource QuietButton}" Click="OnClose" ToolTip="关闭面板，继续在托盘运行" AutomationProperties.Name="关闭面板"><Path Data="M1,1 L11,11 M11,1 L1,11" Width="12" Height="12" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2"/></Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,25,14,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <Button x:Name="DevicesNav" Grid.Row="1" Style="{StaticResource SidebarButton}" Click="OnDevicesNav">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE80F;" Style="{StaticResource SidebarIcon}"/><TextBlock Grid.Column="1" Text="设备概览" VerticalAlignment="Center"/></Grid>
                        </Button>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="SettingsNav" Style="{StaticResource SidebarButton}" Click="OnSettingsNav">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE713;" Style="{StaticResource SidebarIcon}"/><TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center"/></Grid>
                            </Button>
                            <Button x:Name="PluginsNav" Style="{StaticResource SidebarButton}" Click="OnPluginsNav">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8D7;" Style="{StaticResource SidebarIcon}"/><TextBlock Grid.Column="1" Text="插件" VerticalAlignment="Center"/></Grid>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="关闭面板后，&#x0a;充电提醒继续在托盘运行。" Foreground="{DynamicResource TextSecondary}" FontSize="10" LineHeight="18" Margin="14,0,10,0"/>
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <ScrollViewer x:Name="DevicesPage" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="32,28,30,28">
                        <StackPanel>
                            <Grid Margin="0,0,0,23">
                                <StackPanel><TextBlock Text="设备概览" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="少一点电量焦虑，多一点专注。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
                                <Button x:Name="RefreshButton" Content="↻  刷新电量" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefresh"/>
                            </Grid>
                            <Border Style="{StaticResource SectionCard}" Padding="24,21">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="已连接外设" Style="{StaticResource Caption}"/><TextBlock x:Name="TotalText" Text="0" FontSize="33" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="当前在线的外接设备" Style="{StaticResource Caption}"/></StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="可读电量" Style="{StaticResource Caption}"/><TextBlock x:Name="ReadableText" Text="0" FontSize="33" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="设备提供了电量信息" Style="{StaticResource Caption}"/></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="需要充电" Style="{StaticResource Caption}"/><TextBlock x:Name="LowText" Text="0" FontSize="33" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" Margin="0,8,0,3"/><TextBlock Text="低于你设置的提醒值" Style="{StaticResource Caption}"/></StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <Grid Width="80" Height="80"><controls:BatteryRing x:Name="CoverageRing" StrokeThickness="7" Foreground="{DynamicResource Accent}" TrackBrush="{DynamicResource RingTrack}"/><TextBlock x:Name="CoverageText" Text="—" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                        <TextBlock Text="电量读取覆盖率" Style="{StaticResource Caption}" Margin="0,9,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Margin="1,5,1,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="我的外设" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="UpdateText" Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/><Grid Grid.Row="1" Margin="0,13,0,0"><Grid Width="230" HorizontalAlignment="Left"><TextBox x:Name="DeviceSearch" TextChanged="OnFilterChanged" Padding="11,7" AutomationProperties.Name="搜索外设"/><TextBlock x:Name="SearchHint" Text="搜索名称、厂商或连接方式" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><CheckBox x:Name="BatteryOnlyBox" Content="仅显示有电量" Click="OnFilterChanged" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></Grid>
                            <ItemsControl x:Name="DeviceItems" Margin="-6,0,-6,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="15" Padding="19" Margin="6,0,6,12" AllowDrop="True" DragOver="OnDeviceDragOver" Drop="OnDeviceDrop">
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{Binding IconGeometry, Mode=OneWay}" Style="{StaticResource DeviceTypeIcon}"/><TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" Foreground="{Binding NameBrush, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="26,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="7,4" VerticalAlignment="Top"><TextBlock Text="{Binding Status.Category, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource Accent}"/></Border>
                                                </Grid>
                                                <Grid Margin="0,19,0,18">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid Width="70" Height="70" HorizontalAlignment="Left" ToolTip="{Binding Status.BatteryText}" AutomationProperties.Name="{Binding Status.BatteryText}">
                                                        <controls:BatteryVisual Style="{StaticResource OverviewBatteryShape}" Percent="{Binding Status.BatteryPercent, Mode=OneWay}" DisplayStyle="{Binding DisplayStyle, Mode=OneWay}" AnimationsEnabled="{Binding AnimationsEnabled, Mode=OneWay}" IsCharging="{Binding IsCharging, Mode=OneWay}" FillOpacity="{Binding FillOpacity, Mode=OneWay}" ColorOpacity="{Binding ColorOpacity, Mode=OneWay}" AnimationIntensity="{Binding AnimationIntensity, Mode=OneWay}" Foreground="{Binding BatteryBrush, Mode=OneWay}" TrackBrush="{DynamicResource RingTrack}"/>
                                                        <TextBlock Style="{StaticResource BatteryPercentage}" Text="{Binding Status.BatteryText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="{Binding ReminderText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Note, Mode=OneWay}" Style="{StaticResource Caption}" FontSize="10" Margin="0,7,0,0" LineHeight="16"/></StackPanel>
                                                </Grid>
                                                <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Tag="{Binding Id}" Width="20" Height="22" Background="Transparent" Cursor="SizeAll" ToolTip="拖动调整设备顺序" PreviewMouseLeftButtonDown="OnDeviceDragStart" PreviewMouseMove="OnDeviceDragMove"><Path Data="M0,0 H2 V2 H0 Z M5,0 H7 V2 H5 Z M0,5 H2 V7 H0 Z M5,5 H7 V7 H5 Z M0,10 H2 V12 H0 Z M5,10 H7 V12 H5 Z" Fill="{DynamicResource TextSecondary}" Width="7" Height="12" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Status.UpdatedText, Mode=OneWay, StringFormat=读取于 {0}}" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" Content="设置" Style="{StaticResource QuietButton}" Padding="7,5" FontSize="11" Click="OnDeviceSettings" Tag="{Binding Id}" ToolTip="设置此设备的提醒与外观"/><Button Grid.Column="2" Content="{Binding PinLabel, Mode=OneWay}" Style="{StaticResource QuietButton}" Padding="7,5" FontSize="11" Foreground="{DynamicResource Accent}" Click="OnPinDevice" Tag="{Binding Id}"/></Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="NoDevices" Style="{StaticResource SectionCard}" Padding="28"><StackPanel><TextBlock x:Name="NoDevicesTitle" Text="当前没有已连接的外设" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="连接外设后刷新，或调整搜索与筛选条件。" Style="{StaticResource Caption}" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
                            <TextBlock Text="仅显示当前已连接的外设；未提供电量的设备显示为未知。" Style="{StaticResource Caption}" Margin="2,5,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                                        <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="32,28,30,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel x:Name="SettingsTitle" Margin="0,0,152,20"><TextBlock Text="设置" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="从默认配置开始，也能为每台设备保留自己的习惯。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
                        <Grid x:Name="SettingsScopeRow" Grid.Row="1" Margin="0,0,152,16"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SettingsDeviceSelector" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="OnSettingsDeviceChanged" AutomationProperties.Name="选择要设置的设备"/>
                            <TextBlock x:Name="ScopeHint" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                        </Grid>
                        <StackPanel x:Name="SettingsLivePreview" Grid.RowSpan="2" Width="132" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock x:Name="SettingsPreviewName" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,2,3"/>
                            <Grid x:Name="SettingsPreviewGraphic" Width="72" Height="72">
                                <controls:BatteryVisual x:Name="SettingsPreviewVisual" TrackBrush="{DynamicResource RingTrack}"/>
                                <TextBlock x:Name="SettingsPreviewNumber" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="SettingsPreviewHint" Style="{StaticResource Caption}" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/>
                            <CheckBox x:Name="PercentageBox" Content="显示百分比" FontSize="11" HorizontalAlignment="Center" Click="OnPercentageClick" Margin="0,5,0,0" ToolTip="设置所选设备；默认配置用于未单独设置的设备"/>
                        </StackPanel>
                        <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="11" Padding="4" Margin="0,0,0,18">
                            <Grid x:Name="SettingsTabBar" Height="38" SizeChanged="OnSettingsTabSizeChanged">
                                <Border x:Name="SettingsTabIndicator" HorizontalAlignment="Left" Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"><Border.RenderTransform><TranslateTransform x:Name="SettingsTabTranslation"/></Border.RenderTransform></Border>
                                <UniformGrid Columns="4">
                                    <Button x:Name="ReminderTabButton" Content="充电提醒" Tag="reminders" Style="{StaticResource QuietButton}" Padding="6,4" Click="OnSettingsTabClick"/>
                                    <Button x:Name="AppearanceTabButton" Content="设备外观" Tag="appearance" Style="{StaticResource QuietButton}" Padding="6,4" Click="OnSettingsTabClick"/>
                                    <Button x:Name="DesktopTabButton" Content="桌面卡片" Tag="desktop" Style="{StaticResource QuietButton}" Padding="6,4" Click="OnSettingsTabClick"/>
                                    <Button x:Name="GeneralTabButton" Content="通用" Tag="general" Style="{StaticResource QuietButton}" Padding="6,4" Click="OnSettingsTabClick"/>
                                </UniformGrid>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="3">
                            <ScrollViewer x:Name="RemindersTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SectionCard}"><StackPanel>
                                        <Grid><StackPanel Margin="0,0,150,0"><TextBlock Text="安心充电提醒" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ReminderScopeText" Style="{StaticResource Caption}"/></StackPanel><CheckBox x:Name="NotificationsBox" Content="启用提醒" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnNotificationsClick"/></Grid>
                                        <TextBlock x:Name="GlobalReminderHint" Foreground="{DynamicResource Warning}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                                        <Grid Margin="0,26,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0"><TextBlock Text="电量达到多少时提醒" FontSize="13" FontWeight="SemiBold"/><Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><Slider x:Name="ThresholdSlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnThresholdChanged" VerticalAlignment="Center" Margin="0,0,15,0" AutomationProperties.Name="充电提醒阈值"/><TextBox x:Name="ThresholdBox" Grid.Column="1" Style="{StaticResource CompactNumber}" TextChanged="OnThresholdInput" LostFocus="OnThresholdInputLostFocus" KeyDown="OnThresholdInputKeyDown" AutomationProperties.Name="提醒阈值百分比"/><TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="ThresholdText" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock x:Name="ThresholdErrorText" Foreground="{DynamicResource Danger}" FontSize="11" Margin="0,7,0,0" Visibility="Collapsed"/></StackPanel>
                                            <Grid Grid.Column="1" Width="76" Height="76"><controls:BatteryRing x:Name="ThresholdRing" StrokeThickness="6" Foreground="{DynamicResource Accent}" TrackBrush="{DynamicResource RingTrack}"/><TextBlock x:Name="ThresholdPreview" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,24,0,20"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="重复提醒间隔" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="持续低电时，按此间隔再次提醒。" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><ComboBox x:Name="RepeatCombo" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnRepeatChanged" VerticalAlignment="Center"/></Grid>
                                        <Button x:Name="ResetRemindersButton" Content="重置提醒" Click="OnResetReminders" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Foreground="{DynamicResource Accent}" Margin="0,18,0,0" Padding="0,6"/>
                                    </StackPanel></Border>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer x:Name="AppearanceTab" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                                <StackPanel>
                                    <Border x:Name="DeviceIdentityCard" Style="{StaticResource SectionCard}"><StackPanel>
                                        <TextBlock Text="认出你的设备" Style="{StaticResource SectionTitle}"/><TextBlock Text="自定义名称和文字颜色会随设备保存，重新连接后恢复。" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DeviceNameBox" Height="36" Padding="10,0" FontSize="13" MaxLength="80" VerticalContentAlignment="Center" Margin="0,0,14,0" LostFocus="OnDeviceNameLostFocus" KeyDown="OnDeviceNameKeyDown" AutomationProperties.Name="自定义设备名称"/><Button Grid.Column="1" Click="OnNameColorClick" Padding="8,6"><StackPanel Orientation="Horizontal"><Border x:Name="NameColorSwatch" Width="16" Height="16" CornerRadius="5" Margin="0,0,8,0"/><TextBlock Text="名称颜色" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="2" Content="重置" Style="{StaticResource QuietButton}" Padding="10,6" Click="OnResetIdentity" ToolTip="重置为设备原名和主题文字颜色"/></Grid>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource SectionCard}"><controls:AnimatedExpander x:Name="StyleExpander" Header="电量样式" IsExpanded="True"><StackPanel>
