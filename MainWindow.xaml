<Window x:Class="PowerHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PowerHub.Controls"
        Title="PowerHub · 外设电量中心" Icon="/PowerHub;component/Assets/powerhub.ico" Width="1080" Height="780" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource PageBackground}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="LineHeight" Value="18"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DeviceTypeIcon" TargetType="Path">
            <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="46"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="Track" Width="36" Height="21" CornerRadius="11" Background="{DynamicResource RingTrack}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                        <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="{DynamicResource Surface}" Margin="3,0" HorizontalAlignment="Left"/>
                    </Border>
                    <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentText}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Background="{DynamicResource Surface}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="23,0,0,0">
                    <Border Width="23" Height="23" CornerRadius="7" Background="Transparent">
                        <Image Source="/PowerHub;component/Assets/powerhub-32.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="PowerHub" FontWeight="Bold" FontSize="15" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="外设电量中心" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="44" Style="{StaticResource QuietButton}" Click="OnMinimize" ToolTip="最小化"/>
                    <Button Content="□" Width="44" Style="{StaticResource QuietButton}" Click="OnMaximize" ToolTip="最大化或还原"/>
                    <Button Content="×" FontSize="20" Width="46" Style="{StaticResource QuietButton}" Click="OnClose" ToolTip="关闭面板，继续在托盘运行"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,25,14,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="工作空间" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="14,0,0,13"/>
                        <Button x:Name="DevicesNav" Grid.Row="1" Style="{StaticResource SidebarButton}" Click="OnDevicesNav">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE80F;" Style="{StaticResource SidebarIcon}"/><TextBlock Grid.Column="1" Text="设备概览" VerticalAlignment="Center"/></Grid>
                        </Button>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="SettingsNav" Style="{StaticResource SidebarButton}" Click="OnSettingsNav">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE713;" Style="{StaticResource SidebarIcon}"/><TextBlock Grid.Column="1" Text="提醒与外观" VerticalAlignment="Center"/></Grid>
                            </Button>
                            <Button x:Name="WidgetNav" Style="{StaticResource SidebarButton}" Click="OnWidgetNav">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8A9;" Style="{StaticResource SidebarIcon}"/><TextBlock Grid.Column="1" Text="桌面卡片" VerticalAlignment="Center"/></Grid>
                            </Button>
                            <Button x:Name="PluginsNav" Style="{StaticResource SidebarButton}" Click="OnPluginsNav">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8D7;" Style="{StaticResource SidebarIcon}"/><TextBlock Grid.Column="1" Text="插件" VerticalAlignment="Center"/></Grid>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="4" Padding="13" CornerRadius="12" Background="{DynamicResource AccentSoft}">
                            <StackPanel>
                                <TextBlock Text="轻轻留在托盘" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="关掉面板，充电提醒&#x0a;也会继续守候。" Foreground="{DynamicResource TextSecondary}" FontSize="10" LineHeight="18" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <ScrollViewer x:Name="DevicesPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,30,28">
                        <StackPanel>
                            <Grid Margin="0,0,0,23">
                                <StackPanel><TextBlock Text="设备概览" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="少一点电量焦虑，多一点专注。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
                                <Button x:Name="RefreshButton" Content="↻  刷新电量" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefresh"/>
                            </Grid>
                            <Border Style="{StaticResource SectionCard}" Padding="24,21">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="已连接外设" Style="{StaticResource Caption}"/><TextBlock x:Name="TotalText" Text="0" FontSize="33" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="当前在线的外接设备" Style="{StaticResource Caption}"/></StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="可读电量" Style="{StaticResource Caption}"/><TextBlock x:Name="ReadableText" Text="0" FontSize="33" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="设备提供了电量信息" Style="{StaticResource Caption}"/></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="需要充电" Style="{StaticResource Caption}"/><TextBlock x:Name="LowText" Text="0" FontSize="33" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" Margin="0,8,0,3"/><TextBlock Text="低于你设置的提醒值" Style="{StaticResource Caption}"/></StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <Grid Width="80" Height="80"><controls:BatteryRing x:Name="CoverageRing" StrokeThickness="7" Foreground="{DynamicResource Accent}" TrackBrush="{DynamicResource RingTrack}"/><TextBlock x:Name="CoverageText" Text="—" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                        <TextBlock Text="电量读取覆盖率" Style="{StaticResource Caption}" Margin="0,9,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Margin="1,5,1,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="我的外设" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="UpdateText" Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/><Grid Grid.Row="1" Margin="0,13,0,0"><Grid Width="230" HorizontalAlignment="Left"><TextBox x:Name="DeviceSearch" TextChanged="OnFilterChanged" Padding="11,7" AutomationProperties.Name="搜索外设"/><TextBlock x:Name="SearchHint" Text="搜索名称、厂商或连接方式" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><CheckBox x:Name="BatteryOnlyBox" Content="仅显示有电量" Click="OnFilterChanged" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></Grid>
                            <ItemsControl x:Name="DeviceItems" Margin="-6,0,-6,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="15" Padding="19" Margin="6,0,6,12">
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{Binding IconGeometry, Mode=OneWay}" Style="{StaticResource DeviceTypeIcon}"/><TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" Foreground="{Binding NameBrush, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="26,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="7,4" VerticalAlignment="Top"><TextBlock Text="{Binding Status.Category, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource Accent}"/></Border>
                                                </Grid>
                                                <Grid Margin="0,19,0,18">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid Width="70" Height="70" HorizontalAlignment="Left">
                                                        <controls:BatteryVisual Percent="{Binding Status.BatteryPercent, Mode=OneWay}" DisplayStyle="{Binding DisplayStyle, Mode=OneWay}" AnimationsEnabled="{Binding AnimationsEnabled, Mode=OneWay}" IsCharging="{Binding IsCharging, Mode=OneWay}" Foreground="{Binding BatteryBrush, Mode=OneWay}" TrackBrush="{DynamicResource RingTrack}"/>
                                                        <TextBlock Text="{Binding Status.BatteryText, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="{Binding ReminderText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Note, Mode=OneWay}" Style="{StaticResource Caption}" FontSize="10" Margin="0,7,0,0" LineHeight="16"/></StackPanel>
                                                </Grid>
                                                <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                    <Grid><TextBlock Text="{Binding Status.UpdatedText, Mode=OneWay, StringFormat=读取于 {0}}" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/><Button Content="{Binding PinLabel, Mode=OneWay}" Style="{StaticResource QuietButton}" Padding="8,5" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Click="OnPinDevice" Tag="{Binding Id}"/></Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="NoDevices" Style="{StaticResource SectionCard}" Padding="28"><StackPanel><TextBlock x:Name="NoDevicesTitle" Text="当前没有已连接的外设" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="连接外设后刷新，或调整搜索与筛选条件。" Style="{StaticResource Caption}" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
                            <TextBlock Text="仅显示当前已连接的外设；未提供电量的设备显示为未知。" Style="{StaticResource Caption}" Margin="2,5,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,30,28">
                        <StackPanel>
                            <TextBlock Text="提醒与外观" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="让提醒按你的节奏发生，让桌面保持你的风格。" Style="{StaticResource Caption}" Margin="0,8,0,24"/>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <Grid><TextBlock Text="每台设备，独立提醒" Style="{StaticResource SectionTitle}"/><Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="按设备设置" Foreground="{DynamicResource Accent}" FontSize="10"/></Border></Grid>
                                <TextBlock Text="点名称可重命名，如「办公鼠标」；清空恢复原名。阈值输入 1–100，留空跟随默认值。" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                                <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/><ColumnDefinition Width="88"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><TextBlock Text="设备名称" Style="{StaticResource Caption}" FontSize="10"/><TextBlock Grid.Column="1" Text="名称颜色" Style="{StaticResource Caption}" FontSize="10"/><TextBlock Grid.Column="2" Text="充电提醒" Style="{StaticResource Caption}" FontSize="10"/><TextBlock Grid.Column="3" Text="专属阈值" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center"/></Grid>
                                <ItemsControl x:Name="DeviceSettingsItems"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/><ColumnDefinition Width="88"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{Binding IconGeometry, Mode=OneWay}" Style="{StaticResource DeviceTypeIcon}"/><TextBox x:Name="DeviceNameEditor" Grid.Column="1" Text="{Binding Name, Mode=OneWay}" Foreground="{Binding NameBrush, Mode=OneWay}" FontSize="12" Padding="8,7" MaxLength="80" Tag="{Binding Id}" LostFocus="OnDeviceNameLostFocus" KeyDown="OnDeviceNameKeyDown" ToolTip="自定义名称，如 办公鼠标；清空恢复原名。" AutomationProperties.Name="设备自定义名称"/></Grid><TextBlock Text="{Binding ReminderText, Mode=OneWay}" Style="{StaticResource Caption}" Margin="26,5,0,0"/></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Width="32" Height="30" Padding="0" Tag="{Binding Id}" Click="OnNameColorClick" ToolTip="选择这个设备的名称颜色" AutomationProperties.Name="选择设备名称颜色"><Border Width="15" Height="15" CornerRadius="4" Background="{Binding NameBrush, Mode=OneWay}"/></Button>
                                                <Button Content="自动" Style="{StaticResource QuietButton}" FontSize="10" Padding="8,7" Margin="3,0,0,0" Tag="{Binding Id}" Click="OnResetNameColor" ToolTip="恢复名称颜色跟随主题"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Content="提醒" IsChecked="{Binding AlertsEnabled, Mode=OneWay}" Tag="{Binding Id}" Click="OnDeviceAlertClick" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="3"><TextBox Text="{Binding ThresholdOverride, Mode=OneWay}" Tag="{Binding Id}" LostFocus="OnDeviceThresholdLostFocus" KeyDown="OnDeviceThresholdKeyDown" Padding="10,8,23,8" TextAlignment="Center" ToolTip="仅此设备的提醒阈值：输入 1–100，留空使用默认值" AutomationProperties.Name="设备专属提醒阈值"/><TextBlock Text="%" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/></Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock x:Name="NoDeviceSettings" Text="连接外设后，即可在这里分别设置充电提醒。" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                                <TextBlock x:Name="ThresholdErrorText" Foreground="{DynamicResource Danger}" FontSize="11" Margin="0,5,0,0" Visibility="Collapsed"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <Grid><StackPanel Margin="0,0,190,0"><TextBlock Text="安心充电提醒" Style="{StaticResource SectionTitle}"/><TextBlock Text="电量到达阈值时提醒；充电中和离线时暂停提醒。" Style="{StaticResource Caption}"/></StackPanel><CheckBox x:Name="NotificationsBox" Content="开启充电提醒" Click="OnNotificationsClick" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                <Grid Margin="0,23,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="106"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,25,0"><Grid><TextBlock Text="新设备默认阈值" FontSize="12"/><TextBlock x:Name="ThresholdText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/></Grid><TextBlock Text="已设置专属阈值的设备不受影响" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,0,0"/><Slider x:Name="ThresholdSlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,13,0,8" ValueChanged="OnThresholdChanged"/><Grid><TextBlock Text="1% · 更晚提醒" Style="{StaticResource Caption}"/><TextBlock Text="100% · 更早提醒" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid></StackPanel>
                                    <Grid Grid.Column="1" Width="76" Height="76"><controls:BatteryRing x:Name="ThresholdRing" StrokeThickness="6" Foreground="{DynamicResource Accent}" TrackBrush="{DynamicResource RingTrack}"/><TextBlock x:Name="ThresholdPreview" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,22,0,18"/>
                                <Grid><StackPanel><TextBlock Text="重复提醒间隔" FontSize="12"/><TextBlock Text="设备持续低电时，按此间隔再次提醒。" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><ComboBox x:Name="RepeatCombo" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="OnRepeatChanged" DisplayMemberPath="Label" SelectedValuePath="Value"/></Grid>
                            </StackPanel></Border>
                            <Border x:Name="DisplayStyleSection" Style="{StaticResource SectionCard}"><StackPanel>
                                <TextBlock Text="电量，也可以有自己的样子" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="为设备卡片和桌面卡片选择展示方式。以下为效果预览。" Style="{StaticResource Caption}" Margin="0,0,0,18"/>
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="RingStyle" GroupName="DisplayStyle" Style="{StaticResource ThemeChoice}" Tag="Ring" Click="OnDisplayStyleClick" Margin="0,0,6,0"><StackPanel><Grid Height="65" Margin="0,0,0,11"><controls:BatteryVisual x:Name="RingPreview" Width="63" Height="63" Percent="65" DisplayStyle="Ring" Foreground="{DynamicResource Accent}" TrackBrush="{DynamicResource RingTrack}"/><TextBlock Text="65%" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="经典圆环" FontSize="11" HorizontalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="BarStyle" GroupName="DisplayStyle" Style="{StaticResource ThemeChoice}" Tag="Bar" Click="OnDisplayStyleClick" Margin="3,0"><StackPanel><Grid Height="65" Margin="0,0,0,11"><controls:BatteryVisual x:Name="BarPreview" Width="76" Height="63" Percent="65" DisplayStyle="Bar" Foreground="{DynamicResource Accent}" TrackBrush="{DynamicResource RingTrack}"/><TextBlock Text="65%" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="简约电池" FontSize="11" HorizontalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="HourglassStyle" GroupName="DisplayStyle" Style="{StaticResource ThemeChoice}" Tag="Hourglass" Click="OnDisplayStyleClick" Margin="3,0"><StackPanel><Grid Height="65" Margin="0,0,0,11"><controls:BatteryVisual x:Name="HourglassPreview" Width="63" Height="63" Percent="65" DisplayStyle="Hourglass" Foreground="{DynamicResource Accent}" TrackBrush="{DynamicResource RingTrack}"/><TextBlock Text="65%" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="流动沙漏" FontSize="11" HorizontalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="OceanStyle" GroupName="DisplayStyle" Style="{StaticResource ThemeChoice}" Tag="Ocean" Click="OnDisplayStyleClick" Margin="6,0,0,0"><StackPanel><Grid Height="65" Margin="0,0,0,11"><controls:BatteryVisual x:Name="OceanPreview" Width="63" Height="63" Percent="65" DisplayStyle="Ocean" Foreground="{DynamicResource Accent}" TrackBrush="{DynamicResource RingTrack}"/><TextBlock Text="65%" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="海洋波浪" FontSize="11" HorizontalAlignment="Center"/></StackPanel></RadioButton>
                                </UniformGrid>
                                <CheckBox x:Name="AnimationsBox" Content="启用电量动效" Click="OnAnimationsClick" Margin="0,20,0,0"/>
                            </StackPanel></Border>
                            <controls:BatteryColorSettings x:Name="BatteryColorPanel"/>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <TextBlock Text="为桌面选一种心情" Style="{StaticResource SectionTitle}"/><TextBlock Text="面板与桌面卡片会一起切换主题。" Style="{StaticResource Caption}" Margin="0,0,0,18"/>
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="SystemTheme" GroupName="Theme" Style="{StaticResource ThemeChoice}" Tag="System" Click="OnThemeClick" Margin="0,0,8,0"><StackPanel><Grid Height="43" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#EFF3F7" CornerRadius="5,0,0,5"/><Border Grid.Column="1" Background="#202838" CornerRadius="0,5,5,0"/><Border Background="#8FE4C5" Height="5" Margin="10,0" VerticalAlignment="Center"/></Grid><TextBlock Text="跟随系统" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="自然适应你的环境" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="LightTheme" GroupName="Theme" Style="{StaticResource ThemeChoice}" Tag="Light" Click="OnThemeClick" Margin="4,0"><StackPanel><Border Height="43" Background="#F3F5F9" CornerRadius="5" Margin="0,0,0,12"><Border Background="#14866B" Height="5" Margin="10,0" VerticalAlignment="Center"/></Border><TextBlock Text="清透浅色" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="明亮、轻盈、清爽" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="DarkTheme" GroupName="Theme" Style="{StaticResource ThemeChoice}" Tag="Dark" Click="OnThemeClick" Margin="8,0,0,0"><StackPanel><Border Height="43" Background="#171D29" CornerRadius="5" Margin="0,0,0,12"><Border Background="#8FE4C5" Height="5" Margin="10,0" VerticalAlignment="Center"/></Border><TextBlock Text="静谧深色" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="柔和、沉静、更专注" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                </UniformGrid>
                                <UniformGrid Columns="4" Margin="0,13,0,0">
                                    <RadioButton x:Name="OceanTheme" GroupName="Theme" Style="{StaticResource ThemeChoice}" Tag="Ocean" Click="OnThemeClick" Margin="0,0,6,0"><StackPanel><Border Height="43" Background="#102B46" CornerRadius="5" Margin="0,0,0,12"><Border Background="#65D8F3" Height="5" Margin="10,0" VerticalAlignment="Center"/></Border><TextBlock Text="深海蓝" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="深色 · 安静蓝调" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="LavenderTheme" GroupName="Theme" Style="{StaticResource ThemeChoice}" Tag="Lavender" Click="OnThemeClick" Margin="3,0"><StackPanel><Border Height="43" Background="#F3EEFC" CornerRadius="5" Margin="0,0,0,12"><Border Background="#8B65C4" Height="5" Margin="10,0" VerticalAlignment="Center"/></Border><TextBlock Text="薰衣草" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="浅色 · 柔和紫调" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="SunsetTheme" GroupName="Theme" Style="{StaticResource ThemeChoice}" Tag="Sunset" Click="OnThemeClick" Margin="3,0"><StackPanel><Border Height="43" Background="#FFF0E5" CornerRadius="5" Margin="0,0,0,12"><Border Background="#C77447" Height="5" Margin="10,0" VerticalAlignment="Center"/></Border><TextBlock Text="暖杏日落" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="浅色 · 温暖杏调" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="ForestTheme" GroupName="Theme" Style="{StaticResource ThemeChoice}" Tag="Forest" Click="OnThemeClick" Margin="6,0,0,0"><StackPanel><Border Height="43" Background="#182D27" CornerRadius="5" Margin="0,0,0,12"><Border Background="#A6D491" Height="5" Margin="10,0" VerticalAlignment="Center"/></Border><TextBlock Text="森林绿" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="深色 · 自然绿调" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                </UniformGrid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <TextBlock Text="轻量运行" Style="{StaticResource SectionTitle}"/><TextBlock Text="按需更新，安静地待在托盘。" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                                <Grid><StackPanel><TextBlock Text="电量扫描间隔" FontSize="12"/><TextBlock Text="较长间隔可以减少设备查询。" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><ComboBox x:Name="PollCombo" DisplayMemberPath="Label" SelectedValuePath="Value" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="OnPollChanged"/></Grid>
                                <CheckBox x:Name="StartWithWindowsBox" Content="开机启动 PowerHub" Click="OnStartWithWindowsClick" Margin="0,22,0,0"/>
                                <CheckBox x:Name="StartInTrayBox" Content="启动时仅显示托盘" Click="OnStartInTrayClick" Margin="0,14,0,0"/>
                                <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,22,0,18"/>
                                <Grid><StackPanel Margin="0,0,150,0"><TextBlock Text="兼容性诊断" FontSize="12"/><TextBlock Text="导出设备信息，帮助后续适配。" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><Button x:Name="ExportButton" Content="导出诊断" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnExport"/></Grid>
                            </StackPanel></Border>
                            <controls:UpdateSettings x:Name="UpdatePanel"/>
                            <TextBlock x:Name="SettingsStatusText" Text="设置会自动保存。" Style="{StaticResource Caption}" Margin="2,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="WidgetsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,30,28">
                        <StackPanel>
                            <TextBlock Text="桌面卡片" FontSize="27" FontWeight="SemiBold"/>
                            <TextBlock Text="把常用设备留在桌面一角，电量和充电状态一眼可见。" Style="{StaticResource Caption}" Margin="0,8,0,24"/>
                            <Border Style="{StaticResource SectionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="桌面电量卡片" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="关闭主面板后，卡片仍会继续显示。" Style="{StaticResource Caption}"/>
                                        <CheckBox x:Name="WidgetBox" Content="启用桌面卡片" Style="{StaticResource SettingSwitch}" Click="OnWidgetClick" Margin="0,19,0,0"/>
                                        <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,22,0,18"/>
                                        <Grid Margin="0,0,0,18"><StackPanel Margin="0,0,55,0"><TextBlock Text="始终置顶" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="在其他窗口上方显示" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="TopmostBox" Style="{StaticResource SettingSwitch}" HorizontalAlignment="Right" Click="OnTopmostClick" AutomationProperties.Name="始终置顶"/></Grid>
                                        <Grid Margin="0,0,0,18"><StackPanel Margin="0,0,55,0"><TextBlock Text="锁定位置" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="防止拖动时误移卡片" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="LockedBox" Style="{StaticResource SettingSwitch}" HorizontalAlignment="Right" Click="OnLockedClick" AutomationProperties.Name="锁定卡片位置"/></Grid>
                                        <Grid Margin="0,0,0,18"><StackPanel Margin="0,0,55,0"><TextBlock Text="简洁模式" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="收起说明，保留设备与电量" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="WidgetCompactBox" Style="{StaticResource SettingSwitch}" HorizontalAlignment="Right" Click="OnWidgetCompactClick" AutomationProperties.Name="简洁模式"/></Grid>
                                        <Grid><StackPanel Margin="0,0,55,0"><TextBlock Text="透明背景" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="让卡片轻轻融入桌面" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="WidgetTransparentBox" Style="{StaticResource SettingSwitch}" HorizontalAlignment="Right" Click="OnWidgetTransparentClick" AutomationProperties.Name="透明背景"/></Grid>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="13" Padding="20" VerticalAlignment="Center">
                                        <StackPanel>
                                            <Grid><TextBlock Text="桌面卡片" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="效果预览" Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Right"/></Grid>
                                            <Grid Width="98" Height="98" Margin="0,23,0,16">
                                                <controls:BatteryVisual x:Name="WidgetPreviewVisual" Percent="65" DisplayStyle="Ocean" Foreground="{DynamicResource Accent}" TrackBrush="{DynamicResource RingTrack}"/>
                                                <TextBlock Text="65%" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="设备电量" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="WidgetStyleText" Text="海洋球 · 动效已开启" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <Grid><StackPanel Margin="0,0,130,0"><TextBlock Text="卡片外观" Style="{StaticResource SectionTitle}"/><TextBlock Text="圆环、条形、沙漏或海洋球；与设备面板使用同一套风格。" Style="{StaticResource Caption}"/></StackPanel><Button Content="调整外观" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnWidgetAppearance"/></Grid>
                            </Border>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <Grid Margin="0,0,0,5"><TextBlock Text="选择显示的设备" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="WidgetSelectionSummary" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                <TextBlock Text="固定需要关注的在线设备。断开后自动隐藏，重新连接时恢复。" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                                <ItemsControl x:Name="WidgetDeviceItems"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,15">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid Width="42" Height="42" HorizontalAlignment="Left"><controls:BatteryVisual Percent="{Binding Status.BatteryPercent, Mode=OneWay}" DisplayStyle="{Binding DisplayStyle, Mode=OneWay}" AnimationsEnabled="{Binding AnimationsEnabled, Mode=OneWay}" IsCharging="{Binding IsCharging, Mode=OneWay}" Foreground="{Binding BatteryBrush, Mode=OneWay}" TrackBrush="{DynamicResource RingTrack}"/><TextBlock Text="{Binding Status.BatteryText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{Binding IconGeometry, Mode=OneWay}" Style="{StaticResource DeviceTypeIcon}"/><TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" Foreground="{Binding NameBrush, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding Subtitle, Mode=OneWay}" Style="{StaticResource Caption}" Margin="26,4,0,0"/></StackPanel>
                                            <Button Grid.Column="2" Content="{Binding PinLabel, Mode=OneWay}" Style="{StaticResource QuietButton}" Foreground="{DynamicResource Accent}" Padding="10,8" Tag="{Binding Id}" Click="OnPinDevice" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Border x:Name="NoWidgetDevices" Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="20" Margin="0,4,0,0"><StackPanel><TextBlock Text="暂时没有可固定的在线设备" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="连接外设后，在设备概览中刷新电量。" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Border>
                            </StackPanel></Border>
                            <TextBlock x:Name="WidgetStatusText" Text="设置会自动保存。" Style="{StaticResource Caption}" Margin="2,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="PluginsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,30,28">
                        <controls:PluginSettings x:Name="PluginPanel"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
