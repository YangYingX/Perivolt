<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>PowerHub.Program</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PowerHub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/powerhub.ico</ApplicationIcon>
    <CetCompat>false</CetCompat>
    <Version>1.1.1</Version>
    <Description>Windows 外设电量中心</Description>
    <Product>电栖 · Perivolt</Product>
    <Title>电栖 · Perivolt</Title>
    <AssemblyTitle>电栖 · Perivolt</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DiagnosticUploadEndpoint" Value="$(DiagnosticUploadEndpoint)" />
    <Resource Include="Assets/powerhub.ico;Assets/powerhub-32.png" />
    <EmbeddedResource Include="Locales/*.json" />
    <Compile Remove="Extensions/**/*.cs" />
    <Compile Include="Extensions/Optional/PeripheralHub/AudioController.cs;Extensions/Optional/PeripheralHub/AudioInterop.cs" />
    <Compile Remove="macOS/**/*.cs" />
    <Compile Remove="Services/*BatteryReader.cs" />
    <EmbeddedResource Remove="Extensions/**/*" />
    <None Remove="Extensions/**/bin/**/*;Extensions/**/obj/**/*" />
    <None Update="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="NOTICE.md;AUTHORS.md;LICENSES/MIT-legacy.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="scripts/Diagnose-Startup.cmd" TargetPath="Diagnose-Startup.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="BrandPublishedAppHost" AfterTargets="Publish"
          Condition="Exists('$(PublishDir)PowerHub.exe')">
    <!-- Keep the managed assembly name for existing plugins and WPF resource URIs. -->
    <Copy SourceFiles="$(PublishDir)PowerHub.exe" DestinationFiles="$(PublishDir)Perivolt.exe" />
    <Delete Files="$(PublishDir)PowerHub.exe" />
  </Target>
</Project>
