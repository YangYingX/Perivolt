<ContextMenu x:Class="PowerHub.TrayMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="324" StaysOpen="False" HasDropShadow="False"
             Background="Transparent" BorderThickness="0" Padding="0"
             Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI, Microsoft YaHei UI"
             FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
             KeyboardNavigation.DirectionalNavigation="Cycle">
    <ContextMenu.Resources>
        <Style x:Key="MenuGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MenuDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,9,8,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Row" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="12"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="10,0,0,0"
                                                      RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CheckedMark" Grid.Column="2" Text="&#xE73E;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource Accent}" Visibility="Collapsed"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                               Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Right" HorizontalOffset="-10" VerticalOffset="-10"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="12" Padding="6" MinWidth="222" CornerRadius="13"
                                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                        TextElement.Foreground="{DynamicResource TextPrimary}"
                                        TextElement.FontFamily="Segoe UI, Microsoft YaHei UI" TextElement.FontSize="13">
                                    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="18" ShadowDepth="4"/></Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckedMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuHeader" TargetType="MenuItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="MenuItem"><ContentPresenter ContentSource="Header" Margin="12,9,12,11"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuDivider" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Stroke}" Margin="12,6"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </ContextMenu.Resources>
    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                    CornerRadius="16" Padding="6" Margin="12">
                <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="21" ShadowDepth="5"/></Border.Effect>
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>

    <MenuItem Style="{StaticResource MenuHeader}">
        <MenuItem.Header>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <TextBlock Text="PowerHub" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="外设电量中心" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <Border CornerRadius="7" Background="{DynamicResource SurfaceAlt}" Padding="9,7" Margin="0,13,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{DynamicResource TextSecondary}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusSummary" Text="暂无在线设备" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </MenuItem.Header>
    </MenuItem>
    <MenuItem Tag="show" Click="OnActionClick" AutomationProperties.Name="打开设备面板">
        <MenuItem.Icon><TextBlock Text="&#xE80F;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="打开设备面板" FontWeight="SemiBold"/><TextBlock Text="查看设备电量与连接状态" Style="{StaticResource MenuDescription}"/></StackPanel></MenuItem.Header>
    </MenuItem>
    <MenuItem x:Name="WidgetItem" Tag="widget-settings" Click="OnActionClick" AutomationProperties.Name="桌面卡片">
        <MenuItem.Icon><TextBlock Text="&#xE7F4;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="桌面卡片"/><TextBlock Text="固定设备、置顶与卡片外观" Style="{StaticResource MenuDescription}"/></StackPanel></MenuItem.Header>
    </MenuItem>
    <MenuItem x:Name="NotificationsItem" IsCheckable="True" Click="OnNotificationsClick" AutomationProperties.Name="充电提醒">
        <MenuItem.Icon><TextBlock Text="&#xEA8F;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="充电提醒"/><TextBlock x:Name="NotificationsDescription" Style="{StaticResource MenuDescription}"/></StackPanel></MenuItem.Header>
    </MenuItem>
    <Separator Style="{StaticResource MenuDivider}"/>
    <MenuItem AutomationProperties.Name="外观主题">
        <MenuItem.Icon><TextBlock Text="&#xE790;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="外观主题"/><TextBlock x:Name="ThemeDescription" Style="{StaticResource MenuDescription}"/></StackPanel></MenuItem.Header>
        <MenuItem x:Name="SystemThemeItem" Header="跟随系统" Tag="System" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="LightThemeItem" Header="清透浅色" Tag="Light" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE706;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="DarkThemeItem" Header="静谧深色" Tag="Dark" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE708;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <Separator Style="{StaticResource MenuDivider}"/>
        <MenuItem x:Name="OceanThemeItem" Header="深海蓝" Tag="Ocean" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE774;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="LavenderThemeItem" Header="薰衣草" Tag="Lavender" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE790;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="SunsetThemeItem" Header="暖杏" Tag="Sunset" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE706;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="ForestThemeItem" Header="森林绿" Tag="Forest" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE8BE;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
    </MenuItem>
    <MenuItem AutomationProperties.Name="电量样式">
        <MenuItem.Icon><TextBlock Text="&#xE9D9;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="电量样式"/><TextBlock x:Name="DisplayDescription" Style="{StaticResource MenuDescription}"/></StackPanel></MenuItem.Header>
        <MenuItem x:Name="RingStyleItem" Header="圆环" Tag="Ring" IsCheckable="True" Click="OnDisplayStyleClick"><MenuItem.Icon><TextBlock Text="&#xEA3A;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="BarStyleItem" Header="电池条" Tag="Bar" IsCheckable="True" Click="OnDisplayStyleClick"><MenuItem.Icon><TextBlock Text="&#xE945;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="HourglassStyleItem" Header="沙漏" Tag="Hourglass" IsCheckable="True" Click="OnDisplayStyleClick"><MenuItem.Icon><TextBlock Text="&#xE823;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="OceanStyleItem" Header="海洋球" Tag="Ocean" IsCheckable="True" Click="OnDisplayStyleClick"><MenuItem.Icon><TextBlock Text="&#xE774;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <Separator Style="{StaticResource MenuDivider}"/>
        <MenuItem x:Name="AnimationsItem" Header="电量动效" IsCheckable="True" Click="OnAnimationsClick"><MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
    </MenuItem>
    <MenuItem Header="提醒与外观设置" Tag="settings" Click="OnActionClick"><MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
    <MenuItem Header="立即刷新" Tag="refresh" Click="OnActionClick"><MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
    <Separator Style="{StaticResource MenuDivider}"/>
    <MenuItem Header="退出 PowerHub" Tag="exit" Click="OnActionClick" Foreground="{DynamicResource Danger}">
        <MenuItem.Icon><TextBlock Text="&#xE8BB;" Style="{StaticResource MenuGlyph}" Foreground="{DynamicResource Danger}"/></MenuItem.Icon>
    </MenuItem>
</ContextMenu>
