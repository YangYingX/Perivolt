<ContextMenu x:Class="PowerHub.TrayMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:PowerHub.Controls"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="288" StaysOpen="False" HasDropShadow="False"
             Background="Transparent" BorderThickness="0" Padding="0"
             Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI, Microsoft YaHei UI"
             FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
             KeyboardNavigation.DirectionalNavigation="Cycle">
    <ContextMenu.Resources>
        <Style x:Key="MenuGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MenuDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6,6,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Row" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="10"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="8,0,0,0"
                                                      RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CheckedMark" Grid.Column="2" Text="&#xE73E;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource Accent}" Visibility="Collapsed"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                               Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Right" HorizontalOffset="-8" VerticalOffset="-8"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="10" Padding="5" MinWidth="210" CornerRadius="11"
                                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                        TextElement.Foreground="{DynamicResource TextPrimary}"
                                        TextElement.FontFamily="Segoe UI, Microsoft YaHei UI" TextElement.FontSize="13">
                                    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="16" ShadowDepth="2"/></Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckedMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuHeader" TargetType="MenuItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="MenuItem"><ContentPresenter ContentSource="Header" Margin="10,6,10,7"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuDivider" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Stroke}" Margin="10,4"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </ContextMenu.Resources>
    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                    CornerRadius="12" Padding="5" Margin="10">
                <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="16" ShadowDepth="2"/></Border.Effect>
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>

    <MenuItem Style="{StaticResource MenuHeader}">
        <MenuItem.Header>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <TextBlock Text="{loc:T 'AppName'}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T '外设电量中心'}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <Border CornerRadius="6" Background="{DynamicResource SurfaceAlt}" Padding="8,5" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{DynamicResource TextSecondary}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusSummary" Grid.Column="1" Text="{loc:T '暂无在线设备'}" FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </StackPanel>
        </MenuItem.Header>
    </MenuItem>
    <MenuItem Tag="show" Click="OnActionClick" AutomationProperties.Name="{loc:T '打开设备面板'}">
        <MenuItem.Icon><TextBlock Text="&#xE80F;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="{loc:T '打开设备面板'}" FontWeight="SemiBold"/><TextBlock Text="{loc:T '查看设备电量与连接状态'}" Style="{StaticResource MenuDescription}"/></StackPanel></MenuItem.Header>
    </MenuItem>
    <MenuItem x:Name="WidgetItem" Tag="widget-settings" Click="OnActionClick" AutomationProperties.Name="{loc:T '桌面卡片'}">
        <MenuItem.Icon><TextBlock Text="&#xE7F4;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="{loc:T '桌面卡片'}"/><TextBlock Text="{loc:T '固定设备、置顶与卡片外观'}" Style="{StaticResource MenuDescription}"/></StackPanel></MenuItem.Header>
    </MenuItem>
    <MenuItem x:Name="NotificationsItem" IsCheckable="True" Click="OnNotificationsClick" AutomationProperties.Name="{loc:T '充电提醒'}">
        <MenuItem.Icon><TextBlock Text="&#xEA8F;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="{loc:T '充电提醒'}"/><TextBlock x:Name="NotificationsDescription" Style="{StaticResource MenuDescription}"/></StackPanel></MenuItem.Header>
    </MenuItem>
    <Separator Style="{StaticResource MenuDivider}"/>
    <MenuItem AutomationProperties.Name="{loc:T '外观主题'}">
        <MenuItem.Icon><TextBlock Text="&#xE790;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="{loc:T '外观主题'}"/><TextBlock x:Name="ThemeDescription" Style="{StaticResource MenuDescription}"/></StackPanel></MenuItem.Header>
        <MenuItem x:Name="SystemThemeItem" Header="{loc:T '跟随系统'}" Tag="System" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="LightThemeItem" Header="{loc:T '清透浅色'}" Tag="Light" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE706;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="DarkThemeItem" Header="{loc:T '静谧深色'}" Tag="Dark" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE708;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <Separator Style="{StaticResource MenuDivider}"/>
        <MenuItem x:Name="OceanThemeItem" Header="{loc:T '深海蓝'}" Tag="Ocean" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE774;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="LavenderThemeItem" Header="{loc:T '薰衣草'}" Tag="Lavender" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE790;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="SunsetThemeItem" Header="{loc:T '暖杏'}" Tag="Sunset" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE706;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="ForestThemeItem" Header="{loc:T '森林绿'}" Tag="Forest" IsCheckable="True" Click="OnThemeClick"><MenuItem.Icon><TextBlock Text="&#xE8BE;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
    </MenuItem>
    <MenuItem AutomationProperties.Name="{loc:T '电量样式'}">
        <MenuItem.Icon><TextBlock Text="&#xE9D9;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="{loc:T '电量样式'}"/><TextBlock x:Name="DisplayDescription" Style="{StaticResource MenuDescription}"/></StackPanel></MenuItem.Header>
        <MenuItem x:Name="RingStyleItem" Header="{loc:T '圆环'}" Tag="Ring" IsCheckable="True" Click="OnDisplayStyleClick"><MenuItem.Icon><TextBlock Text="&#xEA3A;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="BarStyleItem" Header="{loc:T '电池条'}" Tag="Bar" IsCheckable="True" Click="OnDisplayStyleClick"><MenuItem.Icon><TextBlock Text="&#xE945;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="HourglassStyleItem" Header="{loc:T '沙漏'}" Tag="Hourglass" IsCheckable="True" Click="OnDisplayStyleClick"><MenuItem.Icon><TextBlock Text="&#xE823;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="OceanStyleItem" Header="{loc:T '海洋球'}" Tag="Ocean" IsCheckable="True" Click="OnDisplayStyleClick"><MenuItem.Icon><TextBlock Text="&#xE774;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="FillStyleItem" Header="{loc:T '底色填充'}" Tag="Fill" IsCheckable="True" Click="OnDisplayStyleClick"><MenuItem.Icon><TextBlock Text="&#xE790;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
        <Separator Style="{StaticResource MenuDivider}"/>
        <MenuItem x:Name="AnimationsItem" Header="{loc:T '电量动效'}" IsCheckable="True" Click="OnAnimationsClick"><MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
    </MenuItem>
    <MenuItem Header="{loc:T '提醒与外观设置'}" Tag="settings" Click="OnActionClick"><MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
    <MenuItem Header="{loc:T '立即刷新'}" Tag="refresh" Click="OnActionClick"><MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
    <Separator Style="{StaticResource MenuDivider}"/>
    <MenuItem Header="{loc:T '退出 PowerHub'}" Tag="exit" Click="OnActionClick" Foreground="{DynamicResource Danger}">
        <MenuItem.Icon><TextBlock Text="&#xE8BB;" Style="{StaticResource MenuGlyph}" Foreground="{DynamicResource Danger}"/></MenuItem.Icon>
    </MenuItem>
</ContextMenu>
