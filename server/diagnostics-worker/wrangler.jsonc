{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perivolt-diagnostics",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "REPORT_COORDINATOR", "class_name": "ReportCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReportCoordinator"] }
  ]
}
